# Copy this file to .env and adjust as needed.

# Fontra version: "latest", or a release such as 2026.10.0
# (https://github.com/fontra/fontra/tags). When building, "main" also works.
FONTRA_VERSION=latest

# Empty font to create when the fonts folder is empty, so the start page has
# something to open. Leave the value empty to turn this off.
FONTRA_DEFAULT_FONT=default.designspace

# Host port to publish Fontra on (http://localhost:<port>).
FONTRA_PORT=8000

# Other published images to use, for example from a fork:
# IMAGE_PREFIX=ghcr.io/<owner>/<repo>

# Build the image yourself instead of pulling it (see docker-compose.build.yml):
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml

# When building: the user that owns files Fontra creates in ./fonts. Match
# your own user (`id -u`, `id -g`). Published images use 1000.
FONTRA_UID=1000
FONTRA_GID=1000
