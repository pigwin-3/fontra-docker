# Settings for the multi-user stack. Create .env with random secrets by
# running ./init-env.sh, or copy this file to .env and fill in the blanks.

# Host name or IP address people use to reach this server. It is used for
# the self-signed certificate and for Django's ALLOWED_HOSTS.
PUBLIC_HOST=localhost

# Host ports. Fontra is at https://PUBLIC_HOST:FONTRA_PORT/ and the
# django-robo-cjk admin site at https://PUBLIC_HOST:ROBOCJK_PORT/admin/
FONTRA_PORT=8443
ROBOCJK_PORT=9443

# Admin account, created on the first start. It can log in to Fontra and to
# the admin site, where you add users and projects.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Secrets. Never change HASHIDS_SALT after the first start.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DJANGO_SECRET_KEY=
JWT_SECRET=
HASHIDS_SALT=

# Fontra version: "latest", or a release such as 2026.10.0. When building,
# "main" also works.
FONTRA_VERSION=latest

# Other published images to use, for example from a fork:
# IMAGE_PREFIX=ghcr.io/<owner>/<repo>

# Build the images yourself instead of pulling them (see
# docker-compose.build.yml), and which django-robo-cjk branch, tag or commit
# to build:
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
ROBOCJK_VERSION=master
