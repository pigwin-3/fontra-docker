# The nginx image renders this to /etc/nginx/conf.d/fontra.conf at startup,
# filling in ${NGINX_LOCAL_RESOLVERS}.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Look up the other containers per request, so nginx keeps working when one
# of them is recreated with a new IP address.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

ssl_certificate     /etc/nginx/certs/fullchain.pem;
ssl_certificate_key /etc/nginx/certs/privkey.pem;
ssl_protocols       TLSv1.2 TLSv1.3;
ssl_session_cache   shared:SSL:10m;
ssl_session_timeout 1d;

# Fontra, the font editor.
server {
    listen 8443 ssl;
    http2 on;
    server_name _;
    client_max_body_size 64m;

    # The export page (multiuser/exporter). Building .otf/.ttf files can take
    # a while.
    location /export/ {
        set $exporter http://exporter:8000;
        proxy_pass $exporter;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 35m;
    }

    location / {
        set $fontra http://fontra:8000;
        proxy_pass $fontra;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Every open editor window keeps a WebSocket connection.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}

# django-robo-cjk: the admin site (/admin/) and the API that Fontra uses.
# Fontra reaches it inside the compose network as https://proxy:9443.
server {
    listen 9443 ssl;
    http2 on;
    server_name _;
    client_max_body_size 256m;

    # Django serves these folders with directory listings turned on.
    location ~ ^/(media|static)/(.*/)?$ {
        return 404;
    }

    location / {
        set $robocjk http://robocjk:8000;
        proxy_pass $robocjk;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
    }
}
