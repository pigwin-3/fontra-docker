+    this._rootObject.axes = ensureDenseAxes(axes);
+    this._rootObject.sources = ensureDenseSources(sources);
+    this._rootObject.unitsPerEm = unitsPerEm;
+    this._rootObject.customData = customData;
+    this._rootObject.metaInfo = metaInfo;
