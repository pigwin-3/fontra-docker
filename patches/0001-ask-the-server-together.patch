+    this.backendInfo = backendInfo;
+    this.readOnly = readOnly;
 
     if (initListener) {
       this.addChangeListener(
@@ -169,7 +191,20 @@ export class FontController {
       if (!methodName) {
         throw Error(`unknown data key: ${key}`);
       }
-      this._rootObject[key] = await this.font[methodName]();
+      // One request for everyone who asks while it is on its way, such as
+      // the shaper controller's early ask (see getShaperFontData there).
+      if (!this._dataRequests) {
+        this._dataRequests = {};
+      }
+      if (!this._dataRequests[key]) {
+        this._dataRequests[key] = this.font[methodName]().finally(() => {
+          delete this._dataRequests[key];
